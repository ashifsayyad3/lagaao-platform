{
  "name": "lagaao-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend/api-gateway",
    "backend/services/auth-service",
    "backend/services/product-service",
    "backend/services/cart-service",
    "backend/services/order-service",
    "backend/services/payment-service"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:gateway\" \"npm run dev:services\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:gateway": "npm run start:dev --workspace=backend/api-gateway",
    "dev:auth": "npm run start:dev --workspace=backend/services/auth-service",
    "dev:product": "npm run start:dev --workspace=backend/services/product-service",
    "dev:cart": "npm run start:dev --workspace=backend/services/cart-service",
    "dev:order": "npm run start:dev --workspace=backend/services/order-service",
    "dev:payment": "npm run start:dev --workspace=backend/services/payment-service",
    "dev:services": "concurrently \"npm run dev:auth\" \"npm run dev:product\" \"npm run dev:cart\" \"npm run dev:order\" \"npm run dev:payment\"",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=frontend",
    "build:gateway": "npm run build --workspace=backend/api-gateway",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "db:generate": "npm run db:generate --workspace=database",
    "db:migrate": "npm run db:migrate --workspace=database",
    "db:studio": "npm run db:studio --workspace=database",
    "docker:up": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.yml down",
    "docker:build": "docker-compose -f infrastructure/docker/docker-compose.yml build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
