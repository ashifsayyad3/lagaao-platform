# lagaao.com — Apache reverse proxy config for Hostinger
# Place this file (or symlink it) in ~/public_html/

Options -Indexes
DirectoryIndex disabled

RewriteEngine On

# ── Force HTTPS ───────────────────────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── www → non-www canonical redirect ─────────────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.lagaao\.com [NC]
RewriteRule ^ https://lagaao.com%{REQUEST_URI} [L,R=301]

# ── Proxy /api/* → API Gateway on port 4000 ──────────────────────────────────
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^(.*)$ http://127.0.0.1:4000/$1 [P,L]
ProxyPassReverse /api/ http://127.0.0.1:4000/api/

# ── Proxy all other requests → Next.js frontend on port 3000 ─────────────────
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
ProxyPassReverse / http://127.0.0.1:3000/

# ── Security headers ──────────────────────────────────────────────────────────
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# ── Cache static assets ───────────────────────────────────────────────────────
<FilesMatch "\.(ico|css|js|gif|jpg|jpeg|png|svg|webp|woff2?)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
